# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/
.ipynb_checkpoints/

# Virtual envs
.venv/
venv/
env/

# Cached downloads (regenerated at runtime from AlphaFold DB / NMRlipids)
cache/*.pdb
cache/*.json

# Real-image probe: raw EMDB map + parsed volume (re-fetchable from the EMD-65182
# URL documented in validation/real_image_probe.py; the slice PNG is kept)
cache/real_images/*.map.gz
cache/real_images/*.npy

# Large synthetic movie arrays (regenerable from synth_movie.py with fixed seeds;
# ground-truth JSON + montage/validation figures are kept)
outputs/*.npz

# OS
.DS_Store
outputs/_sweep_log.txt
cache/real_images/emd_53909.png
outputs/field_movie.npy
outputs/_tracking_sweep.json
outputs/per_track_recovery_oracle.json

*.ome.tif
*.mat
curvo/validation/realdata/_raw/

# BioTISR raw SIM cache — re-fetchable from Zenodo 13843670 via range requests
cache/biotisr/

# Mund/Ries 3D-SMLM LocMoFit fits — re-fetchable from BioStudies S-BIAD566
cache/smlm_locmofit/
# Derived geometry set (rebuilt by ingest_smlm_locmofit from the cached fits)
validation/realdata/smlm_geometry_set.json

# agent scratch handoff
handoff/
*.mrc

# Cached protein structures + rendered sprites (re-fetchable from RCSB / AlphaFold DB)
cache/structures/
