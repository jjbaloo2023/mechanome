# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/
.ipynb_checkpoints/

# Virtual envs
.venv/
venv/
env/

# Cached downloads (regenerated at runtime from AlphaFold DB / NMRlipids)
cache/*.pdb
cache/*.json

# Real-image probe: raw EMDB map + parsed volume (re-fetchable from the EMD-65182
# URL documented in validation/real_image_probe.py; the slice PNG is kept)
cache/real_images/*.map.gz
cache/real_images/*.npy

# Large synthetic movie arrays (regenerable from synth_movie.py with fixed seeds;
# ground-truth JSON + montage/validation figures are kept)
outputs/*.npz

# OS
.DS_Store
outputs/_sweep_log.txt
cache/real_images/emd_53909.png
outputs/field_movie.npy
outputs/_tracking_sweep.json
outputs/per_track_recovery_oracle.json

*.ome.tif
*.mat
curvo/validation/realdata/_raw/

# BioTISR raw SIM cache — re-fetchable from Zenodo 13843670 via range requests
cache/biotisr/

# Mund/Ries 3D-SMLM LocMoFit fits — re-fetchable from BioStudies S-BIAD566
cache/smlm_locmofit/
# Derived geometry set (rebuilt by ingest_smlm_locmofit from the cached fits)
validation/realdata/smlm_geometry_set.json

# agent scratch handoff
handoff/
*.mrc

# Cached protein structures + rendered sprites (re-fetchable from RCSB / AlphaFold DB)
cache/structures/

# Generated duplicates of the canonical manuscript figures in figures/.
outputs/epsin_domain_cases.png
outputs/orchestration.png
validation/realdata/picalm_orchestration.png

# Local research/test scratch; never scientific evidence
.pytest-*/
research/.mpl-*/

# Downloaded public source payloads; keep their URLs and hashes in metadata
research/metadata/dasc-methods-001/*.xml
research/metadata/dasc-metadata-001/*.docx
research/metadata/dasc-metadata-001/*.xlsx
research/metadata/dynamin-manifest-001/*.bin
research/locmofit_cap_source_current.m
research/.cache-bucher-em-001/
research/.cache-bucher-reconcile-001/

# Inert author-source cache for bounded actin inventory; retain metadata and hashes
research/metadata/actin-inventory-001/03-README.md
research/metadata/actin-inventory-001/*.cym
research/metadata/actin-inventory-001/*.ipynb
research/metadata/actin-inventory-001/*.headers

# Public Myo1E input cache; provenance and unchanged hashes are retained
research/metadata/myo1e-repository-001/*.csv
research/metadata/myo1e-repository-001/*.headers

# Public yeast Figure6 source cache; retain URLs, checks and byte hashes
research/metadata/yeast-figure6-001/*.csv
research/metadata/yeast-figure6-001/*.headers
